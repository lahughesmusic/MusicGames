{
  "expo": {
    "name": "Music Games: Learn to Read Music",
    "slug": "music-games-learn-to-read-music",
    "version": "1.1",
    "icon": "app/assets/images/icon.png",
    "scheme": "renamemusicalhangman",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "app/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "buildNumber": "5",
      "bundleIdentifier": "com.leamcshan.MusicalHangmanAndMore",
      "requireFullScreen": true,
      "supportsTablet": true,
      "supportedInterfaceOrientations": [
        "portrait",
        "landscapeLeft",
        "landscapeRight",
        "portrait",
        "landscapeLeft",
        "landscapeRight"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-screen-orientation",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "app/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e90aafaf-8cf8-4500-9f68-e37dece28de3"
      }
    }
  }
}